{
  "name": "atrapo",
  "productName": "Atrapo",
  "version": "1.0.2",
  "private": true,
  "description": "Atrapo: descarga música, vídeo e imágenes en tu ordenador",
  "author": "Atrapo",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
